# Shared OpenAI defaults. Any agent can override these with
# ANISHA_<AGENT>_<SETTING>; for research_agent the prefix is ANISHA_RESEARCH.
ANISHA_LLM_PROVIDER=openai
ANISHA_LLM_MODEL=gpt-5.4-mini-2026-03-17
# Set this only in backend/.env or the deployment secret store.
# OPENAI_API_KEY=...

# Retained only for an explicit local Ollama override.
ANISHA_OLLAMA_HOST=http://127.0.0.1:11434
ANISHA_CONTEXT_LENGTH=8192
ANISHA_MAX_OUTPUT_TOKENS=512
ANISHA_TEMPERATURE=0.2
ANISHA_KEEP_ALIVE=10m
ANISHA_OLLAMA_THINK=false
# End an unresponsive local-inference call instead of leaving a task running.
ANISHA_LLM_TIMEOUT_SECONDS=120

# Coding-agent overrides
ANISHA_CODING_MODEL=gpt-5.4-mini-2026-03-17

# Coding-agent runtime
# Default sandbox for coding tasks, resolved relative to the repository root.
ANISHA_WORKSPACE_ROOT=.
# The built-in red-wine-quality project is always confined to ml_project.
# Add project-specific sandboxes for other projects. Unmapped projects use the
# default above; built-in mappings cannot be overridden.
ANISHA_PROJECT_WORKSPACES={"red-wine-quality":"ml_project"}
# ANISHA_PROJECT_WORKSPACES={"red-wine-quality":"ml_project","calculator-demo":"examples/coding-agent-calculator"}
ANISHA_CODING_MAX_STEPS=20

# Writing-agent model and draft-generation settings
ANISHA_WRITING_MODEL=gpt-5.4-mini-2026-03-17
ANISHA_WRITING_CONTEXT_LENGTH=16384
ANISHA_WRITING_MAX_OUTPUT_TOKENS=2048
ANISHA_WRITING_TEMPERATURE=0.35
ANISHA_WRITING_MAX_CALLS=15

# Optional provider overrides can be set independently for every agent.
# ANISHA_WRITING_LLM_PROVIDER=openai-compatible
# ANISHA_WRITING_LLM_BASE_URL=https://provider.example/v1
# ANISHA_WRITING_LLM_API_KEY=...

# Comma-separated trusted Python modules. Each exports create_agent(context).
# ANISHA_AGENT_MODULES=my_agents.research,my_agents.communication

# Local speech recognition
ANISHA_WHISPER_MODEL=small

# Isolated phone study. Keep the token private; do not enable development controls
# for measured sessions. Trial data defaults to backend/study_data/trials.sqlite3.
# ANISHA_STUDY_RESEARCHER_TOKEN=replace-with-a-long-random-value
# ANISHA_STUDY_DB_PATH=/absolute/path/to/study-data/trials.sqlite3
# ANISHA_STUDY_DEV_CONTROLS=false

# Voice intent extraction
# Voice intent extraction after local Whisper transcription.
OPENAI_MODEL=gpt-5.6-luna

# Compact mobile summaries and attention ranking. Set false to disable model calls.
ANISHA_ORCHESTRATOR_MODEL=gpt-5.6-luna
ANISHA_ATTENTION_LLM_ENABLED=true

# Optional third-party OpenAI-compatible provider override
# ANISHA_LLM_PROVIDER=openai-compatible
# ANISHA_LLM_BASE_URL=https://provider.example/v1
# ANISHA_LLM_API_KEY=...
